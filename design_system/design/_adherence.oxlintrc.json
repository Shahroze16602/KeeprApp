{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/feedback/**",
              "components/progress/**",
              "components/surfaces/**",
              "ui_kits/keepr-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo))/i]",
        "message": "Font not provided by the design system. Available: Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|variant|icon|label|locked|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, variant, icon, label, locked."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:keep|gone|reward|win|neutral|ink)$/]",
        "message": "<Badge> tone must be one of 'keep' | 'gone' | 'reward' | 'win' | 'neutral' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pill|milestone)$/]",
        "message": "<Badge> variant must be one of 'pill' | 'milestone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|disabled|icon|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, full, disabled, icon, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:keep|gone|reward|neutral|ghost)$/]",
        "message": "<Button> variant must be one of 'keep' | 'gone' | 'reward' | 'neutral' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComboCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:combo|key|ref|className|style|children)$/]",
        "message": "<ComboCounter> doesn't accept that prop. Declared props: combo."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|shape|disabled|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, variant, size, shape, disabled, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:keep|gone|reward|neutral|glass)$/]",
        "message": "<IconButton> variant must be one of 'keep' | 'gone' | 'reward' | 'neutral' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|squircle)$/]",
        "message": "<IconButton> shape must be one of 'circle' | 'squircle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LevelCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:month|year|total|done|reclaim|state|level|key|ref|className|style|children)$/]",
        "message": "<LevelCard> doesn't accept that prop. Declared props: month, year, total, done, reclaim, state, level."
      },
      {
        "selector": "JSXOpeningElement[name.name='LevelCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:active|done)$/]",
        "message": "<LevelCard> state must be one of 'active' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|date|meta|swipe|progress|tilt|children|key|ref|className|style|children)$/]",
        "message": "<PhotoCard> doesn't accept that prop. Declared props: image, date, meta, swipe, progress, tilt, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoCard'] > JSXAttribute[name.name='swipe'] > Literal[value!=/^(?:keep|gone)$/]",
        "message": "<PhotoCard> swipe must be one of 'keep' | 'gone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PileTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|detail|accent|thumb|icon|key|ref|className|style|children)$/]",
        "message": "<PileTile> doesn't accept that prop. Declared props: label, count, detail, accent, thumb, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|thickness|color|track|gradient|showValue|label|children|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: value, size, thickness, color, track, gradient, showValue, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|size|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SegmentedControl> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|size|slam|key|ref|className|style|children)$/]",
        "message": "<Stamp> doesn't accept that prop. Declared props: kind, size, slam."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:keep|gone|super)$/]",
        "message": "<Stamp> kind must be one of 'keep' | 'gone' | 'super'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Stamp> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|prefix|suffix|label|decimals|size|color|gradient|duration|animate|key|ref|className|style|children)$/]",
        "message": "<StatNumber> doesn't accept that prop. Declared props: value, prefix, suffix, label, decimals, size, color, gradient, duration, animate."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreakBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|live|key|ref|className|style|children)$/]",
        "message": "<StreakBadge> doesn't accept that prop. Declared props: days, live."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
